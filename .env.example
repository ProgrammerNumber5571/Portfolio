# Copy to `.env` to make the contact form deliver straight to your inbox.
# Any service that accepts a JSON POST works. Formspree is the quickest:
#   1. Sign up at https://formspree.io and create a form
#   2. Copy the endpoint it gives you
#   3. Paste it below, then restart `npm run dev`
#
# Leave this unset and the form falls back to handing the message to the
# visitor's mail client / Gmail, with a copy-to-clipboard option.

VITE_CONTACT_ENDPOINT=
